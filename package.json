{
  "name": "@brianmorton/crew",
  "version": "0.3.0",
  "description": "Autonomous agent team: role-specialized coding agents that propose typed work into Linear or Jira, gate material changes behind human-approved PRDs, and drain approved work into PRs — running on your machine against your Claude subscription.",
  "type": "module",
  "license": "MIT",
  "author": "Brian Morton",
  "homepage": "https://github.com/brianmmorton/crew#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianmmorton/crew.git"
  },
  "bugs": {
    "url": "https://github.com/brianmmorton/crew/issues"
  },
  "keywords": [
    "agent",
    "agents",
    "ai",
    "claude",
    "coding-agent",
    "linear",
    "jira",
    "automation",
    "cli"
  ],
  "bin": {
    "crew": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "test": "node --test --import tsx \"./src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "crew": "tsx src/cli/index.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@linear/sdk": "^37.0.0",
    "commander": "^12.1.0",
    "croner": "^10.0.1",
    "ink": "^6.8.0",
    "jimp": "^1.6.1",
    "react": "^19.2.8",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^19.2.17",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
