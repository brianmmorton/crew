# Copy this file to `.env` (same folder) and fill in your secrets.
# `.env` is gitignored — it will NOT be committed.
#
# Alternatively, put these in ~/.crew/env to share across all projects
# (recommended for the launchd/cron setup, since launchd ignores your shell rc).

# --- Tracker credentials ---------------------------------------------------
# Fill in the block matching `tracker.provider` in config.yaml. Delete the other.

# provider: linear
# Linear personal API key: Linear → Settings → Security & access → Personal API keys
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxx

# provider: jira  (Jira Cloud)
# Token: id.atlassian.com → Security → Create and manage API tokens
# JIRA_HOST=your-site.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=ATATT3xxxxxxxxxxxxxxxxxxxx

# --- Code host -------------------------------------------------------------
# Only needed when `repo.forge` is "bitbucket". GitHub needs nothing here — the
# `gh` CLI carries its own auth (run `gh auth login`).
#
# Either an access token (workspace, project, or repository scope):
# BITBUCKET_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxx
#
# ...or a username + app password. The app password needs the
# "Pull requests: Write" scope. Create one at:
# bitbucket.org → Personal settings → App passwords
# Note: BITBUCKET_USERNAME is your Bitbucket username, not your email.
# BITBUCKET_USERNAME=your-username
# BITBUCKET_APP_PASSWORD=xxxxxxxxxxxxxxxxxxxx

# --- Agent -----------------------------------------------------------------
# Only needed when `agent.provider` is "claude". Other CLIs use their own auth.
# Long-lived Claude token for headless runs: generate with `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=xxxxxxxxxxxxxxxxxxxx
